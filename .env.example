HOST=127.0.0.1
PORT=8765
ENABLE_ACCOUNT_REGISTRATION=false
TRUST_PROXY=false
# Set as a secret on your hosting provider, never commit credentials.
# ACCOUNTS_DATABASE_URL=postgresql://...

# Loja: habilitar somente após confirmar a conta administradora com o criador.
# STORE_ADMIN_USERNAMES=usuario_confirmado
# STORE_SETTINGS_KEY=64_hex_characters_generated_securely
PUBLIC_BASE_URL=https://khar-tall-online.onrender.com

# Checkout Integrado InfinitePay (identificação pública; sem senha bancária)
STORE_PAYMENT_PROVIDER=infinitepay
INFINITEPAY_HANDLE=

# Frete: alternativa de configuracao pelos segredos do servidor existente.
# A configuracao criptografada salva no painel tem prioridade.
# Nunca preencha credenciais neste arquivo versionado.
MELHOR_ENVIO_ENABLED=false
MELHOR_ENVIO_ORIGIN_POSTAL_CODE=
MELHOR_ENVIO_CONTACT_EMAIL=
MELHOR_ENVIO_TOKEN=
